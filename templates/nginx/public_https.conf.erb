server {
    listen 80<%= default_server_suffix %>;
    listen [::]:80<%= default_server_suffix %>;
    server_name _;

    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name <%= config.frontend_host %> <%= config.api_host %>;

    root <%= File.join(config.fetch("paths").fetch("frontend_root"), "current", config.fetch("frontend").fetch("output_directory")) %>;
    error_page 418 = @local_smoke_frontend;
    set $mitsubachi_local_smoke "";
    if ($remote_addr = 127.0.0.1) { set $mitsubachi_local_smoke L; }
    if ($remote_addr = ::1) { set $mitsubachi_local_smoke L; }
    if ($host = <%= config.frontend_host %>) { set $mitsubachi_local_smoke "${mitsubachi_local_smoke}F"; }

    location ^~ /.well-known/acme-challenge/ {
        root <%= config.fetch("https").fetch("acme_webroot") %>;
        default_type text/plain;
    }

    location / {
        if ($mitsubachi_local_smoke = LF) { return 418; }
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        return 301 https://$host$request_uri;
    }

    location @local_smoke_frontend {
        add_header Cache-Control "no-cache";
        error_page 404 =200 /index.html;
        try_files $uri $uri/ =404;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <%= config.frontend_host %>;

    ssl_certificate /etc/letsencrypt/live/<%= config.frontend_host %>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<%= config.frontend_host %>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10G;
    client_body_timeout 3600s;
    send_timeout 3600s;

    root <%= File.join(config.fetch("paths").fetch("frontend_root"), "current", config.fetch("frontend").fetch("output_directory")) %>;
    index index.html;

    location = /index.html {
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    location /assets/ {
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        add_header Cache-Control "no-cache";
        error_page 404 =200 /index.html;
        try_files $uri $uri/ =404;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <%= config.api_host %>;

    ssl_certificate /etc/letsencrypt/live/<%= config.api_host %>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<%= config.api_host %>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10G;
    client_body_timeout 3600s;
    send_timeout 3600s;

    location = <%= config.fetch("backend").fetch("health_path") %>/ready {
        proxy_pass http://127.0.0.1:<%= config.fetch("ports").fetch("rails") %>;
        proxy_set_header Host $host;
    }

    location / {
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        proxy_pass http://127.0.0.1:<%= config.fetch("ports").fetch("rails") %>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_connect_timeout 30s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        access_log /var/log/nginx/mitsubachi-api-diagnostic.log mitsubachi_diagnostic;
        access_log /var/log/nginx/mitsubachi_upload_access.jsonl mitsubachi_upload_json if=$mitsubachi_is_upload_request;
    }

    location /internal/storage/drive_items/ {
        internal;
        alias /mnt/external-hdd/mitsubachi/files/drive_items/;
        sendfile on;
        tcp_nopush on;
        # X-Accel-Redirect 後はこの location が最終レスポンスを生成するため、
        # Rails で許可した公開 frontend 向け CORS 契約をここでも維持する。
        add_header Access-Control-Allow-Origin "https://<%= config.frontend_host %>" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Expose-Headers "Content-Disposition" always;
        add_header Vary "Origin" always;
        add_header X-Content-Type-Options nosniff always;
    }
}
