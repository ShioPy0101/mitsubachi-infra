server {
    listen 80<%= default_server_suffix %>;
    listen [::]:80<%= default_server_suffix %>;
    server_name _;

    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name <%= config.frontend_host %> <%= config.api_host %>;

    location ^~ /.well-known/acme-challenge/ {
        root <%= config.fetch("https").fetch("acme_webroot") %>;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <%= config.frontend_host %>;

    ssl_certificate /etc/letsencrypt/live/<%= config.frontend_host %>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<%= config.frontend_host %>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10G;
    client_body_timeout 3600s;
    send_timeout 3600s;

    root <%= File.join(config.fetch("paths").fetch("frontend_root"), "current", config.fetch("frontend").fetch("output_directory")) %>;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <%= config.api_host %>;

    ssl_certificate /etc/letsencrypt/live/<%= config.api_host %>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<%= config.api_host %>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10G;
    client_body_timeout 3600s;
    send_timeout 3600s;

    location / {
        proxy_pass http://127.0.0.1:<%= config.fetch("ports").fetch("rails") %>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_connect_timeout 30s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /internal/storage/drive_items/ {
        internal;
        alias /mnt/external-hdd/mitsubachi/files/drive_items/;
        sendfile on;
        tcp_nopush on;
        add_header X-Content-Type-Options nosniff always;
    }
}
