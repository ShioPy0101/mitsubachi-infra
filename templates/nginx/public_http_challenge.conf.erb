server {
    listen 80<%= default_server_suffix %>;
    listen [::]:80<%= default_server_suffix %>;
    server_name _;

    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name <%= config.frontend_host %>;

    location ^~ /.well-known/acme-challenge/ {
        root <%= config.fetch("https").fetch("acme_webroot") %>;
        default_type text/plain;
    }

    root <%= File.join(config.fetch("paths").fetch("frontend_root"), "current", config.fetch("frontend").fetch("output_directory")) %>;
    index index.html;

    location = /index.html {
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    location /assets/ {
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        add_header Cache-Control "no-cache";
        error_page 404 =200 /index.html;
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name <%= config.api_host %>;

    location ^~ /.well-known/acme-challenge/ {
        root <%= config.fetch("https").fetch("acme_webroot") %>;
        default_type text/plain;
    }

    client_max_body_size 10G;
    client_body_timeout 3600s;
    send_timeout 3600s;

    location = <%= config.fetch("backend").fetch("health_path") %>/ready {
        proxy_pass http://127.0.0.1:<%= config.fetch("ports").fetch("rails") %>;
        proxy_set_header Host $host;
    }

    location / {
        set $mitsubachi_maintenance "";
        if (-f <%= config.fetch("release").fetch("maintenance_flag") %>) { set $mitsubachi_maintenance enabled; }
        if ($remote_addr = 127.0.0.1) { set $mitsubachi_maintenance ""; }
        if ($remote_addr = ::1) { set $mitsubachi_maintenance ""; }
        if ($mitsubachi_maintenance = enabled) { return 503; }
        proxy_pass http://127.0.0.1:<%= config.fetch("ports").fetch("rails") %>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_connect_timeout 30s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /internal/storage/drive_items/ {
        internal;
        alias /mnt/external-hdd/mitsubachi/files/drive_items/;
        sendfile on;
        tcp_nopush on;
        add_header X-Content-Type-Options nosniff always;
    }
}
