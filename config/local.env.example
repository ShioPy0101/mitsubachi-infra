# Mitsubachi LAN installation non-secret configuration.
# Copy to config/local.env and edit for the target Ubuntu server.
# Do not put secrets in this file. Secrets belong in /etc/mitsubachi/rails.env.

SERVER_IP=192.168.1.50
LAN_CIDR=192.168.1.0/24
RAILS_REPO_URL=git@github.com:ShioPy0101/mitsubachi-ruby.git
RAILS_REF=main
DEPLOY_USER=deploy
POSTGRES_ROLE=mitsubachi
POSTGRES_DATABASE=mitsubachi_production
KEEP_RELEASES=5
ENABLE_UFW=true
ALLOW_SSH=true
REMOVE_NGINX_DEFAULT_SITE=false
