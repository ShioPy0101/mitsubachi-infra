#!/usr/bin/env bash
set -uo pipefail

usage() { echo "usage: $0 --session-id UUID --output-dir DIR [--mount-point PATH] [--database-url URL]" >&2; exit 2; }
session_id=""; output_root=""; mount_point="/mnt/external-hdd"; database_url=""
while (($#)); do
  case "$1" in
    --session-id) session_id="${2:-}"; shift 2 ;;
    --output-dir) output_root="${2:-}"; shift 2 ;;
    --mount-point) mount_point="${2:-}"; shift 2 ;;
    --database-url) database_url="${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done
[[ "$session_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]] || usage
[[ -n "$output_root" && "$output_root" = /* ]] || usage

session_dir="${output_root%/}/${session_id}"
lock_dir="${session_dir}.lock"
mkdir -p "$output_root"
if ! mkdir "$lock_dir" 2>/dev/null; then echo "capture already active: $session_id" >&2; exit 1; fi
mkdir -m 0750 "$session_dir" || { rmdir "$lock_dir"; exit 1; }
children=()
cleanup() {
  trap - INT TERM EXIT
  for pid in "${children[@]}"; do kill "$pid" 2>/dev/null || true; done
  for pid in "${children[@]}"; do wait "$pid" 2>/dev/null || true; done
  snapshot after
  date --iso-8601=seconds >"$session_dir/ended_at.txt"
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
commit_at() { git -C "$1" rev-parse HEAD 2>/dev/null || true; }
memory_bytes=$(awk '/MemTotal/{print $2 * 1024}' /proc/meminfo 2>/dev/null || echo 0)
filesystem=$(findmnt -n -o FSTYPE --target "$mount_point" 2>/dev/null || true)
cat >"$session_dir/metadata.json" <<JSON
{"upload_session_id":"$(json_escape "$session_id")","started_at":"$(date --iso-8601=seconds)","hostname":"$(json_escape "$(hostname)")","kernel":"$(json_escape "$(uname -r)")","cpu_count":$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 0),"memory_bytes":${memory_bytes%.*},"mount_point":"$(json_escape "$mount_point")","filesystem":"$(json_escape "$filesystem")","frontend_commit_sha":"$(commit_at /var/www/mitsubachi-frontend/current)","backend_commit_sha":"$(commit_at /var/www/mitsubachi/current)","infra_commit_sha":"$(commit_at "$(cd "$(dirname "$0")/.." && pwd)")"}
JSON

snapshot() {
  phase="$1"; output="$session_dir/${phase}-snapshot.txt"
  { date --iso-8601=seconds; df -P "$mount_point"; free -b 2>/dev/null || true; uptime; ss -s 2>/dev/null || true; } >"$output"
  if command -v psql >/dev/null && [[ -n "$database_url" ]]; then
    psql "$database_url" -X -v ON_ERROR_STOP=1 -Atc "select json_build_object('database_bytes',pg_database_size(current_database()),'connections',(select count(*) from pg_stat_activity where datname=current_database()),'wal_lsn',pg_current_wal_lsn(),'drive_items',(select reltuples::bigint from pg_class where relname='drive_items'),'upload_metrics',(select reltuples::bigint from pg_class where relname='upload_metrics'));" >"$session_dir/${phase}-database.json" 2>"$session_dir/${phase}-database-error.log" || true
    psql "$database_url" -X -Atc "select relname,pg_total_relation_size(oid) from pg_class where relname in ('drive_items','upload_metrics');" >"$session_dir/${phase}-table-sizes.csv" 2>/dev/null || true
  fi
}

start_metric() {
  label="$1"; shift
  if command -v "$1" >/dev/null; then "$@" >"$session_dir/${label}.log" 2>&1 & children+=("$!");
  else printf 'command unavailable: %s\n' "$1" >"$session_dir/${label}.log"; fi
}

snapshot before
date --iso-8601=seconds >"$session_dir/started_at.txt"
start_metric vmstat vmstat 1
start_metric iostat iostat -xz 1
start_metric pidstat pidstat -durh 1
start_metric sar-network sar -n DEV 1
(
  while :; do
    date --iso-8601=seconds
    df -P "$mount_point" 2>/dev/null || true
    free -b 2>/dev/null || true
    ps -eo pid,ppid,comm,%cpu,%mem,rss,vsz --sort=-%cpu | awk 'NR==1 || /nginx|puma|rails|postgres|solid_queue/'
    printf 'tcp_connections='; ss -Htan 2>/dev/null | wc -l
    for pid in $(pgrep -f 'nginx|puma|rails|postgres|solid_queue' 2>/dev/null || true); do printf 'pid=%s fd_count=' "$pid"; find "/proc/$pid/fd" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l; done
    sleep 10
  done
) >"$session_dir/periodic.log" 2>&1 & children+=("$!")
printf '%s\n' "$$" >"$session_dir/capture.pid"
printf '%s\n' "${children[@]}" >"$session_dir/child-pids.txt"
echo "capturing into $session_dir; press Ctrl-C to stop"
wait
