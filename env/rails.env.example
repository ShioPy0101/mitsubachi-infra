RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_LOG_LEVEL=info
RAILS_SERVE_STATIC_FILES=false

RAILS_MASTER_KEY=
SECRET_KEY_BASE=
DATABASE_URL=
DATABASE_CACHE_URL=
DATABASE_QUEUE_URL=
DATABASE_CABLE_URL=

FILE_STORAGE_ROOT=/mnt/external-hdd/mitsubachi/files
BULK_DOWNLOAD_TMP=/mnt/external-hdd/mitsubachi/tmp/bulk_downloads
MAX_UPLOAD_SIZE_BYTES=10737418240

APP_HOST=mitsubachi-api.shiosalt.com
ALLOWED_HOSTS=mitsubachi-api.shiosalt.com,127.0.0.1,localhost
FRONTEND_ORIGIN=https://mitsubachi.shiosalt.com
FRONTEND_URL=https://mitsubachi.shiosalt.com

SESSION_COOKIE_SECURE=true

RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
PORT=3000

RESEND_API_KEY=
MAIL_FROM=
